# neuromem-bench environment configuration
# Loaded automatically by scripts/deploy/*.sh

# HuggingFace authentication (required for gated models like Llama-3.1)
# Get your token at: https://huggingface.co/settings/tokens
# Must accept model license at: https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct
# HUGGING_FACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HuggingFace mirror (set to hf-mirror.com for China mainland)
HF_ENDPOINT=https://hf-mirror.com

# vLLM deployment ports
DEPLOY_LLM_PORT=18000       # meta-llama/Llama-3.1-8B-Instruct  → /v1/chat/completions
DEPLOY_EMBED_PORT=18001     # BAAI/bge-m3                        → /v1/embeddings

# vLLM deployment GPU selection (CUDA_VISIBLE_DEVICES)
# Single GPU: DEPLOY_LLM_GPUS=0
# Multi-GPU:  DEPLOY_LLM_GPUS=0,1
# All GPUs:   DEPLOY_LLM_GPUS=all
DEPLOY_LLM_GPUS=1          # GPU(s) for Llama-3.1-8B-Instruct
DEPLOY_EMBED_GPUS=1        # GPU(s) for BAAI/bge-m3

# GPU memory utilization fraction for vLLM (0.0–1.0)
# If LLM and embed share the same GPU, lower LLM utilization accordingly.
# bge-m3 uses ~28 GB on an 80 GB card → set to 0.60 when sharing.
# Use 0.90 when Llama has the GPU to itself.
DEPLOY_LLM_GPU_UTIL=0.60
DEPLOY_EMBED_GPU_UTIL=0.30

# HuggingFace Hub download settings
# Increase timeout (seconds) and retries to cope with mirror instability.
HF_HUB_HTTP_TIMEOUT=120
HF_HUB_DOWNLOAD_RETRY_COUNT=5
